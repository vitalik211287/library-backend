generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ReadingStatus {
  NOT_STARTED
  READING
  PAUSED
  FINISHED
}

enum ProgressMode {
  PAGES
  PERCENT
}

enum LibraryRole {
  OWNER
  ADMIN
  MEMBER
}

model User {
  id           String  @id @default(uuid())
  name         String?
  email        String  @unique
  passwordHash String
  avatarUrl    String?

  books           UserBook[]
  readingSessions ReadingSession[]
  readingGoals    ReadingGoal[]

  following Follow[] @relation("UserFollowing")
  followers Follow[] @relation("UserFollowers")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  libraryMemberships LibraryMember[]
}

model Follow {
  id String @id @default(uuid())

  followerId  String
  followingId String

  follower  User @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Book {
  id          String  @id @default(uuid())
  isbn        String  @unique
  title       String
  author      String
  publisher   String?
  year        Int?
  pages       Int?
  genre       String?
  language    String?
  coverUrl    String?
  description String?

  currentPage Int           @default(0)
  status      ReadingStatus @default(NOT_STARTED)
  rating      Int?

  users           UserBook[]
  readingSessions ReadingSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  libraries LibraryBook[]
}

model UserBook {
  id String @id @default(uuid())

  userId String
  bookId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  progressMode ProgressMode @default(PAGES)

  currentPage    Int @default(0)
  currentPercent Int @default(0)

  status ReadingStatus @default(NOT_STARTED)
  rating Int?

  isWishlist Boolean @default(false)

  finishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, bookId])
}

model ReadingSession {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  bookId String
  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)

  progressMode ProgressMode @default(PAGES)

  startedAt  DateTime
  finishedAt DateTime?

  startPage Int
  endPage   Int?

  startPercent Int?
  endPercent   Int?

  durationSeconds Int?

  pausedAt      DateTime?
  pausedSeconds Int       @default(0)

  createdAt DateTime @default(now())
}

model ReadingGoal {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  year Int

  booksGoal   Int?
  pagesGoal   Int?
  minutesGoal Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, year])
}

model Library {
  id String @id @default(uuid())

  name String

  members LibraryMember[]
  books   LibraryBook[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LibraryMember {
  id String @id @default(uuid())

  libraryId String
  userId    String

  role LibraryRole @default(MEMBER)

  library Library @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([libraryId, userId])
  @@index([libraryId])
  @@index([userId])
}

model LibraryBook {
  id String @id @default(uuid())

  libraryId String
  bookId    String

  library Library @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  book    Book    @relation(fields: [bookId], references: [id], onDelete: Cascade)

  addedAt DateTime @default(now())

  @@unique([libraryId, bookId])
  @@index([libraryId])
  @@index([bookId])
}
