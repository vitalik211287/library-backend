generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Book {
  id          String  @id @default(uuid())
  isbn        String  @unique
  title       String
  author      String
  publisher   String?
  year        Int?
  pages       Int?
  genre       String?
  language    String?
  coverUrl    String?
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
