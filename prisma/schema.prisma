generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ReadingStatus {
  NOT_STARTED
  READING
  PAUSED
  FINISHED
}

enum ProgressMode {
  PAGES
  PERCENT
}

enum UserRole {
  USER
  ADMIN
}

enum LibraryRole {
  OWNER
  ADMIN
  MEMBER
}

model User {
  id           String   @id @default(uuid())
  name         String?
  email        String   @unique
  passwordHash String
  avatarUrl    String?
  role         UserRole @default(USER)
  isBlocked    Boolean  @default(false)

  books           UserBook[]
  readingSessions ReadingSession[]
  readingGoals    ReadingGoal[]

  following Follow[] @relation("UserFollowing")
  followers Follow[] @relation("UserFollowers")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  libraryMemberships LibraryMember[]
  activityLogs       ActivityLog[]

  socialActivities   SocialActivity[]
  activityKudosGiven ActivityKudos[]

  notificationsReceived Notification[] @relation("NotificationRecipient")
  notificationsSent     Notification[] @relation("NotificationActor")
}

model Follow {
  id String @id @default(uuid())

  followerId  String
  followingId String

  follower  User @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Book {
  id          String  @id @default(uuid())
  isbn        String  @unique
  title       String
  author      String
  publisher   String?
  year        Int?
  pages       Int?
  genre       String?
  language    String?
  coverUrl    String?
  description String?

  // Legacy fields kept for database compatibility.
  // Personal reading state is stored in UserBook.
  currentPage Int           @default(0)
  rating      Int?
  status      ReadingStatus @default(NOT_STARTED)

  users           UserBook[]
  readingSessions ReadingSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  libraries     LibraryBook[]
  activityLogs  ActivityLog[]
  notifications Notification[]
}

model UserBook {
  id String @id @default(uuid())

  userId String
  bookId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  progressMode ProgressMode @default(PAGES)

  currentPage    Int @default(0)
  currentPercent Int @default(0)

  status ReadingStatus @default(NOT_STARTED)
  rating Int?

  isWishlist Boolean @default(false)

  finishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, bookId])
}

model ReadingSession {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  bookId String
  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)

  progressMode ProgressMode @default(PAGES)

  startedAt  DateTime
  finishedAt DateTime?

  startPage Int
  endPage   Int?

  startPercent Int?
  endPercent   Int?

  durationSeconds Int?

  pausedAt      DateTime?
  pausedSeconds Int       @default(0)

  createdAt DateTime @default(now())
}

model ReadingGoal {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  year Int

  booksGoal   Int?
  pagesGoal   Int?
  minutesGoal Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, year])
}

model Library {
  id String @id @default(uuid())

  name String

  members LibraryMember[]
  books   LibraryBook[]

  goals         LibraryGoal[]
  bookEvents    LibraryBookEvent[]
  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LibraryMember {
  id String @id @default(uuid())

  libraryId String
  userId    String

  role LibraryRole @default(MEMBER)

  library Library @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([libraryId, userId])
  @@index([libraryId])
  @@index([userId])
}

model LibraryBook {
  id String @id @default(uuid())

  libraryId String
  bookId    String

  library Library @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  book    Book    @relation(fields: [bookId], references: [id], onDelete: Cascade)

  title       String?
  author      String?
  publisher   String?
  year        Int?
  pages       Int?
  genre       String?
  language    String?
  coverUrl    String?
  description String?

  addedAt   DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([libraryId, bookId])
  @@index([libraryId])
  @@index([bookId])
}

enum LibraryBookEventType {
  BOOK_ADDED
  BOOK_REMOVED
}

model LibraryGoal {
  id String @id @default(uuid())

  libraryId String
  library   Library @relation(fields: [libraryId], references: [id], onDelete: Cascade)

  year      Int
  booksGoal Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([libraryId, year])
  @@index([libraryId])
}

model LibraryBookEvent {
  id String @id @default(uuid())

  libraryId String
  library   Library @relation(fields: [libraryId], references: [id], onDelete: Cascade)

  bookId String

  type LibraryBookEventType

  occurredAt DateTime @default(now())

  @@index([libraryId, type, occurredAt])
  @@index([bookId])
}

enum ActivityType {
  STATUS_CHANGED
  PROGRESS_CHANGED
  PROGRESS_RESET
  RATING_CHANGED
  WISHLIST_CHANGED
}

model ActivityLog {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  bookId String?
  book   Book?   @relation(fields: [bookId], references: [id], onDelete: Cascade)

  type ActivityType

  oldValue String?
  newValue String?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([bookId, createdAt])
}

enum SocialActivityType {
  ACHIEVEMENT_UNLOCKED
  BOOK_FINISHED
}

enum NotificationScope {
  USER
  LIBRARY
}

enum NotificationType {
  KUDOS_RECEIVED
  NEW_FOLLOWER
  LIBRARY_BOOK_ADDED
}

model SocialActivity {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type SocialActivityType

  achievementId String?
  bookId        String?

  createdAt DateTime @default(now())

  kudos ActivityKudos[]

  @@unique([userId, type, achievementId])
  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@index([bookId])
}

model ActivityKudos {
  id String @id @default(uuid())

  activityId String
  activity   SocialActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([activityId, userId])
  @@index([activityId])
  @@index([userId])
}

model Notification {
  id String @id @default(uuid())

  userId String
  user   User   @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)

  actorId String
  actor   User   @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)

  type  NotificationType
  scope NotificationScope @default(USER)

  activityId String?

  bookId String?
  book   Book?   @relation(fields: [bookId], references: [id], onDelete: Cascade)

  libraryId String?
  library   Library? @relation(fields: [libraryId], references: [id], onDelete: Cascade)

  isRead Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([userId, isRead, createdAt])
  @@index([actorId, createdAt])
  @@index([activityId])
  @@index([bookId])
  @@index([libraryId, createdAt])
}
